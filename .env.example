APPIUM_SERVER_URL=http://127.0.0.1:4723
APPIUM__APP=/absolute/path/to/your.apk
APPIUM__APP_PACKAGE=com.example.yourapp
APPIUM__APP_ACTIVITY=com.example.yourapp.view.activities.SplashActivity
APPIUM__APP_WAIT_ACTIVITY=com.example.yourapp.*
APPIUM__NO_RESET=false
IMPLICIT_WAIT=10
AUTO_START_SERVER=false

# Optional AI triage (ai/triage_api.py). Export these in your SHELL (or CI secrets), not in .env:
# the Settings class rejects unknown keys, so adding them here would break the test run.
#   export ANTHROPIC_API_KEY=...    (never commit a real key)
#   export AI_TRIAGE_MODEL=claude-opus-5-5
